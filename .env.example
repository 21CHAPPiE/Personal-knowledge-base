# ===== 知识库后端 =====
# 数据目录（默认 <repo>/data，包含 knowledge.db 与 uploads/）
# KB_DATA_DIR=D:/aaa_hydro/Personal-knowledge-base/data

# 附件单文件上限（字节），默认 10MB
# KB_UPLOAD_MAX_BYTES=10485760

# 后端监听
# KB_HOST=127.0.0.1
# KB_PORT=8000

# ===== Qwen / LLM Provider（可选，未配置时系统完全可用）=====
# OpenAI-compatible API，例如本地 llama-server 或 Qwen 兼容网关
# QWEN_BASE_URL=http://127.0.0.1:8080/v1
# QWEN_API_KEY=sk-your-key
# QWEN_MODEL=qwen-plus

# ===== STT Provider（可选，未配置时语音只保存原始音频）=====
# STT_BASE_URL=http://127.0.0.1:8080/v1
# STT_API_KEY=sk-your-key
# STT_MODEL=paraformer-v2

# ===== MCP Server =====
# MCP server 访问的 backend 地址
# KB_BASE_URL=http://127.0.0.1:8000
